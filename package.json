{
  "name": "tinycut-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "type": "module",
  "scripts": {
    "prepare:assets": "node src/workers/ai-prepare-assets.mjs && node scripts/prepare-media.mjs",
    "dev": "npm run prepare:assets && vite --host 0.0.0.0",
    "build": "npm run prepare:assets && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@desert-ant-labs/clear": "3.3.0",
    "@litertjs/core": "2.5.1",
    "@huggingface/transformers": "3.8.1",
    "onnxruntime-web": "1.22.0",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/util": "0.12.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.3",
    "typescript": "5.9.2",
    "vitest": "4.1.11",
    "@playwright/test": "1.55.1"
  }
}
